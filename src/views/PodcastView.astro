---
import External from '../components/External.astro';
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import OfferCard from '../components/OfferCard.astro';
import DonateBox from '../components/DonateBox.astro';
import { SITE } from '../site.config.ts';
import type { PodcastSummary } from '../lib/offers.ts';
import { paths, useT, type Lang } from '../i18n/index.ts';

interface Props {
  lang: Lang;
  podcast: PodcastSummary;
}

const { lang, podcast } = Astro.props;
const t = useT(lang);
const p = paths(lang);
const tipUrl = `${SITE.repo}/issues/new?template=${t.templates.newCode}&podd=${encodeURIComponent(podcast.name)}`;

const links = [
  podcast.apple && { href: podcast.apple, label: t.podcast.links.apple },
  podcast.website && { href: podcast.website, label: t.podcast.links.website },
  podcast.rss && { href: podcast.rss, label: t.podcast.links.rss },
].filter(Boolean) as { href: string; label: string }[];
---

<Base lang={lang} title={t.podcast.title(podcast.name)} description={t.podcast.description(podcast.name)}>
  <div class="container page-head">
    <a class="eyebrow" href={p.podcasts}>{t.podcast.eyebrow}</a>
    <div class="title-row">
      <Avatar name={podcast.name} size={72} />
      <div>
        <h1>{podcast.name}</h1>
        {podcast.by && <p class="muted by">{podcast.by}</p>}
      </div>
    </div>
    <ul class="chips">
      {
        links.map((l) => (
          <li>
            <a class="chip" href={l.href} rel="noopener" target="_blank">
              {l.label} <External />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <section class="container section">
    <div class="section-head">
      <h2>{t.podcast.count(podcast.offers.length)}</h2>
    </div>
    {
      podcast.offers.length ? (
        <div class="grid">
          {podcast.offers.map((offer) => (
            <OfferCard offer={offer} lang={lang} showPodcast={false} />
          ))}
        </div>
      ) : (
        <p class="muted">{t.podcast.empty}</p>
      )
    }

    <div class="tip card panel">
      <p>{t.podcast.tip(podcast.name)}</p>
      <a class="btn" href={tipUrl} rel="noopener" target="_blank">{t.nav.contribute}</a>
    </div>
  </section>

  <section class="container section">
    <DonateBox lang={lang} />
  </section>
</Base>

<style>
  .title-row {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 6px;
  }

  .by {
    margin-top: 6px;
  }

  .tip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    margin-top: 24px;
    box-shadow: none;
  }
</style>
