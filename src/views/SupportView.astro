---
import External from '../components/External.astro';
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import { SITE, hasDonations } from '../site.config.ts';
import { useT, type Lang } from '../i18n/index.ts';

const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const d = SITE.donate;

// Swish "typ C"-QR: C<nummer>;<belopp>;<meddelande>;<låsta fält>.
// 6 = belopp (2) och meddelande (4) går att ändra i appen, numret är låst.
const swishQr = d.swish
  ? await QRCode.toString(`C${d.swish.replace(/\D/g, '')};${d.swishAmount};${d.swishMessage};6`, {
      type: 'svg',
      margin: 1,
      color: { dark: '#1f1b16', light: '#ffffff' },
    })
  : '';

const others = [
  d.kofi && { href: d.kofi, label: t.support.kofi },
  d.buymeacoffee && { href: d.buymeacoffee, label: t.support.buymeacoffee },
  d.githubSponsors && { href: d.githubSponsors, label: t.support.githubSponsors },
].filter(Boolean) as { href: string; label: string }[];
---

<Base lang={lang} title={t.support.title} description={t.support.description}>
  <div class="container page-head">
    <h1>{t.support.title}</h1>
    <p class="lead">{t.support.lead}</p>
  </div>

  <section class="container section">
    {!hasDonations() && import.meta.env.DEV && <p class="dev-note">{t.support.notConfigured}</p>}

    <div class="options" hidden={!d.swish && others.length === 0}>
      {
        d.swish && (
          <div class="card panel swish">
            <h2>{t.support.swishTitle}</h2>
            <p class="muted">{t.support.swishText}</p>
            <div class="qr" set:html={swishQr} />
            <p>
              {t.support.swishNumber}: <strong class="number">{d.swish}</strong>
            </p>
          </div>
        )
      }
      {
        others.length > 0 && (
          <div class="card panel">
            <h2>{t.support.otherTitle}</h2>
            <ul class="other">
              {others.map((o) => (
                <li>
                  <a class="btn btn-primary" href={o.href} rel="noopener" target="_blank">
                    {o.label} <External />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class="container section prose">
    <h2>{t.support.whereTitle}</h2>
    <ul>
      {t.support.where.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</Base>

<style>
  .dev-note {
    margin-bottom: 16px;
  }

  .options {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    align-items: start;
  }

  .panel {
    display: grid;
    gap: 12px;
  }

  .qr {
    width: min(240px, 100%);
    padding: 10px;
    background: #fff;
    border-radius: var(--radius-sm);
  }

  .number {
    font-family: var(--font-mono);
  }

  .other {
    display: grid;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .other .btn {
    width: 100%;
  }
</style>
