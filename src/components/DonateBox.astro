---
import { hasDonations } from '../site.config.ts';
import { paths, useT, type Lang } from '../i18n/index.ts';

const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const show = hasDonations() || import.meta.env.DEV;
---

{
  show && (
    <aside class="donate card">
      <div class="cup" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="48" height="48">
          <path
            d="M9 18h24v10a10 10 0 0 1-10 10h-4A10 10 0 0 1 9 28V18Zm24 2h3a5 5 0 0 1 0 10h-3"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path d="M16 7c-2 3 2 5 0 8M23 7c-2 3 2 5 0 8" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
        </svg>
      </div>
      <div class="text">
        <h2>{t.donateBox.title}</h2>
        <p>{t.donateBox.text}</p>
      </div>
      <a class="btn btn-primary" href={paths(lang).support}>
        {t.donateBox.button}
      </a>
    </aside>
  )
}

<style>
  .donate {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px 24px;
    padding: clamp(20px, 3vw, 28px);
    background: var(--accent-soft);
    border-color: transparent;
    box-shadow: none;
  }

  .cup {
    color: var(--accent);
  }

  h2 {
    font-size: 1.3rem;
    margin-bottom: 4px;
  }

  p {
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .donate {
      grid-template-columns: auto 1fr;
    }

    .btn {
      grid-column: 1 / -1;
    }
  }
</style>
